# Launch gate — see docs/launch-switch.md
# false = Coming Soon for public traffic; true = full website
SITE_LAUNCHED=false
# Force Coming Soon even on localhost (QA only)
SITE_LAUNCH_FORCE_GATE=
# Optional: full-site preview via /?preview=YOUR_SECRET
SITE_PREVIEW_SECRET=

# Google Analytics 4 (public measurement ID — set in host env / .env.local)
# Loads on Coming Soon and the full site when present.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact form email delivery (production: Resend)
# Provider: resend | sendgrid | console | ses | smtp
CONTACT_EMAIL_PROVIDER=resend

# Verified domain sender in Resend
CONTACT_FROM=LawGPT <noreply@lawgptapp.com>
CONTACT_REPLY_TO=contact@lawgptapp.com

# Comma-separated internal notification recipients (not shown on the public site)
CONTACT_INTERNAL_RECIPIENTS=contact@lawgptapp.com,alok.bharti@lawgptapp.com,arun.pandey@lawgptapp.com

# Required for Resend — https://resend.com/api-keys
# Put the real key in .env.local only — never commit it.
RESEND_API_KEY=

# SendGrid (optional alternative)
SENDGRID_API_KEY=

# Future spam protection (Turnstile / reCAPTCHA)
CONTACT_CAPTCHA_PROVIDER=
CONTACT_CAPTCHA_SECRET=

# Razorpay subscriptions (server-only — never expose KEY_SECRET to the browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_MONTHLY_PLAN_ID=
RAZORPAY_PRO_YEARLY_PLAN_ID=

# Deployment mode for webhook Test/Live isolation (server-only)
# Use test with Test Mode keys + Test webhook secret; live with Live keys + Live secret.
RAZORPAY_MODE=test

# Razorpay webhook secret (Dashboard → Webhooks). Separate from RAZORPAY_KEY_SECRET.
# Test Mode and Live Mode each have their own webhook secret — set the matching one.
# Must NOT be prefixed with NEXT_PUBLIC_.
RAZORPAY_WEBHOOK_SECRET=

# LawGPT Supabase Auth — MUST be the same project as app.lawgptapp.com
# (public anon key only; hostname should match the LawGPT app SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role (subscription writes; never expose to browser)
# Put the real key in .env.local / host secrets only — never commit it.
# Must NOT be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
NEXT_PUBLIC_LAWGPT_APP_URL=https://app.lawgptapp.com
NEXT_PUBLIC_SITE_URL=https://lawgptapp.com
